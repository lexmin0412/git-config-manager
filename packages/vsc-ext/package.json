{
  "name": "gcm-vscode",
  "displayName": "GCM - Git Config Manager",
  "description": "Manage multiple Git user configs and switch between them easily",
  "private": true,
  "version": "1.10.5",
  "publisher": "lexmin0412",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "github",
    "url": "https://github.com/lexmin0412/git-config-manager",
    "directory": "packages/vsc-ext"
  },
  "icon": "icon.png",
  "activationEvents": [
    "workspaceContains:.git"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gcm-vscode.use",
        "title": "GCM: Switch config",
        "category": "GCM"
      },
      {
        "command": "gcm-vscode.open",
        "title": "GCM: Open on remote",
        "category": "GCM"
      },
      {
        "command": "gcm-vscode.list",
        "title": "GCM: List configs",
        "category": "GCM"
      },
      {
        "command": "gcm-vscode.current",
        "title": "GCM: Show current config",
        "category": "GCM"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run bundle",
    "bundle": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --minify",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "pnpm vsce package --no-dependencies",
    "publish": "pnpm vsce publish --no-dependencies",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^5.56.0",
    "@typescript-eslint/parser": "^5.56.0",
    "@vscode/test-electron": "^2.3.0",
    "@vscode/vsce": "^2.26.1",
    "esbuild": "^0.28.1",
    "eslint": "^8.36.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "@lexmin0412/gcm-api": "1.10.0"
  }
}

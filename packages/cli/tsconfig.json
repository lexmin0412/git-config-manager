{
	"compilerOptions": {
		"moduleResolution": "nodenext",
		"module": "NodeNext",
		"lib": ["es6", "dom"],
		"esModuleInterop": true,
		"types": ["node"],
		"rootDir": "src",
		"strictNullChecks": true,
		"noImplicitAny": true,
		"resolveJsonModule": true,
		"skipLibCheck": true
	},
	"includes": ["src/*"]
}
